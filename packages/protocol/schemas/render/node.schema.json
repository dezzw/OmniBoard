{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniboard.dev/protocol/schemas/render/node.schema.json",
  "title": "RenderNode",
  "description": "Discriminated union on kind. The button kind is valid only when the containing surface key is default; other surfaces must not use button nodes (see fixtures for invalid widgetSmall example).",
  "oneOf": [
    { "$ref": "#/$defs/vstack" },
    { "$ref": "#/$defs/hstack" },
    { "$ref": "#/$defs/grid" },
    { "$ref": "#/$defs/spacer" },
    { "$ref": "#/$defs/conditional" },
    { "$ref": "#/$defs/text" },
    { "$ref": "#/$defs/symbol" },
    { "$ref": "#/$defs/image" },
    { "$ref": "#/$defs/badge" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/gauge" },
    { "$ref": "#/$defs/relativeTime" },
    { "$ref": "#/$defs/countdown" },
    { "$ref": "#/$defs/button" }
  ],
  "$defs": {
    "nodeRef": {
      "$ref": "node.schema.json"
    },
    "vstack": {
      "type": "object",
      "required": ["kind", "children"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "vstack" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeRef" }
        },
        "spacing": { "type": "number" }
      }
    },
    "hstack": {
      "type": "object",
      "required": ["kind", "children"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "hstack" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeRef" }
        },
        "spacing": { "type": "number" }
      }
    },
    "grid": {
      "type": "object",
      "required": ["kind", "children"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "grid" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeRef" }
        },
        "columns": { "type": "integer", "minimum": 1 }
      }
    },
    "spacer": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "spacer" },
        "minLength": { "type": "number", "minimum": 0 }
      }
    },
    "conditional": {
      "type": "object",
      "required": ["kind", "when", "then", "else"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "conditional" },
        "when": { "type": "string" },
        "then": { "$ref": "#/$defs/nodeRef" },
        "else": { "$ref": "#/$defs/nodeRef" }
      }
    },
    "text": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "text" },
        "value": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "symbol" },
        "name": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "image" },
        "source": { "type": "string" }
      }
    },
    "badge": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "badge" },
        "value": { "type": "string" }
      }
    },
    "progress": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "progress" },
        "value": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "gauge": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "gauge" },
        "value": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "relativeTime": {
      "type": "object",
      "required": ["kind", "iso8601"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "relativeTime" },
        "iso8601": { "type": "string", "format": "date-time" }
      }
    },
    "countdown": {
      "type": "object",
      "required": ["kind", "iso8601"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "countdown" },
        "iso8601": { "type": "string", "format": "date-time" }
      }
    },
    "button": {
      "type": "object",
      "required": ["kind", "label", "actionId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "button" },
        "label": { "type": "string" },
        "actionId": { "type": "string" }
      }
    }
  }
}
