{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniboard.dev/schemas/common.json",
  "title": "OmniBoard common types",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "majorMinor": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "iso8601": {
      "type": "string",
      "format": "date-time"
    },
    "itemId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerInstanceId", "localId"],
      "properties": {
        "providerInstanceId": { "type": "string", "minLength": 1 },
        "localId": { "type": "string", "minLength": 1 }
      }
    },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9_-]*)+$",
      "description": "Reverse-DNS namespaced identifier"
    },
    "jsonRpcId": {
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "null" }
      ]
    }
  }
}
